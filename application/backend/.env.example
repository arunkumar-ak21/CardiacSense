# Copy to .env (git-ignored). Everything here is optional.

# Enables AI-written summaries, diet plans and chat. Without a key the app uses rule-based text.
GEMINI_API_KEY=
# OPENAI_API_KEY=

# Comma-separated Gemini models, tried in order (default: gemini-3.5-flash,gemini-3.1-flash-lite)
# GEMINI_MODEL=

# Use a different folder for the ECG-age weights (default: CardiacSense/model)
# CODE15_MODEL_DIR=
